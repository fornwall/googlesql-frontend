{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fornwall/googlesql-frontend/schema/response.schema.json",
  "title": "googlesql-frontend NDJSON response",
  "description": "One standard-output success or error response object, encoded on one NDJSON line.",
  "type": "object",
  "required": [
    "protocolVersion"
  ],
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "analyze": {
      "$ref": "#/$defs/analyzeSuccess"
    },
    "parse": {
      "$ref": "#/$defs/parseSuccess"
    },
    "builtinFunctions": {
      "$ref": "#/$defs/builtinFunctionsSuccess"
    },
    "languageOptions": {
      "$ref": "#/$defs/languageOptionsSuccess"
    },
    "analyzerOptions": {
      "$ref": "#/$defs/analyzerOptionsSuccess"
    },
    "error": {
      "$ref": "#/$defs/error"
    }
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "required": [
        "analyze"
      ]
    },
    {
      "required": [
        "parse"
      ]
    },
    {
      "required": [
        "builtinFunctions"
      ]
    },
    {
      "required": [
        "languageOptions"
      ]
    },
    {
      "required": [
        "analyzerOptions"
      ]
    },
    {
      "required": [
        "error"
      ]
    }
  ],
  "$defs": {
    "int32": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647
    },
    "analyzeResponse": {
      "type": "object",
      "description": "Exactly one resolved AST, or, when the request set responseOptions.omitResponseProto, none of them and the resumeBytePosition that survives it.",
      "properties": {
        "resolvedStatement": {
          "type": "object"
        },
        "resumeBytePosition": {
          "$ref": "#/$defs/int32"
        },
        "resolvedExpression": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "resolvedStatement"
          ]
        },
        {
          "required": [
            "resolvedExpression"
          ]
        },
        {
          "required": [
            "resumeBytePosition"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "resolvedStatement"
                ]
              },
              {
                "required": [
                  "resolvedExpression"
                ]
              }
            ]
          }
        }
      ]
    },
    "parseResponse": {
      "type": "object",
      "description": "Exactly one parsed AST, or, when the request set responseOptions.omitResponseProto, none of them and the resumeBytePosition that survives it.",
      "properties": {
        "parsedStatement": {
          "type": "object"
        },
        "resumeBytePosition": {
          "$ref": "#/$defs/int32"
        },
        "parsedScript": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "parsedStatement"
          ]
        },
        {
          "required": [
            "parsedScript"
          ]
        },
        {
          "required": [
            "resumeBytePosition"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "parsedStatement"
                ]
              },
              {
                "required": [
                  "parsedScript"
                ]
              }
            ]
          }
        }
      ]
    },
    "extendedParseResponse": {
      "type": "object",
      "properties": {
        "parsedExpression": {
          "type": "object"
        },
        "parsedType": {
          "type": "object"
        },
        "parsedStatement": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "parsedExpression"
          ]
        },
        {
          "required": [
            "parsedType"
          ]
        },
        {
          "required": [
            "parsedStatement"
          ]
        }
      ]
    },
    "builtinFunctionsResponse": {
      "type": "object",
      "properties": {
        "function": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "types": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "tableValuedFunction": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "analyzeSuccess": {
      "type": "object",
      "description": "Both members render the same resolved AST, after the rewrites the request enabled through analyze.rewrites and request.options.enabledRewrites. response is absent only when the request set responseOptions.omitResponseProto and the analysis left no resumeBytePosition to carry.",
      "required": [
        "debugString"
      ],
      "properties": {
        "response": {
          "$ref": "#/$defs/analyzeResponse"
        },
        "debugString": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "parseSuccess": {
      "type": "object",
      "description": "Never both response and extendedResponse. Both are absent only when the request set responseOptions.omitResponseProto and the parse left no resumeBytePosition to carry.",
      "required": [
        "debugString"
      ],
      "properties": {
        "response": {
          "$ref": "#/$defs/parseResponse"
        },
        "extendedResponse": {
          "$ref": "#/$defs/extendedParseResponse"
        },
        "debugString": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "not": {
        "required": [
          "response",
          "extendedResponse"
        ]
      }
    },
    "builtinFunctionsSuccess": {
      "type": "object",
      "required": [
        "response"
      ],
      "properties": {
        "response": {
          "$ref": "#/$defs/builtinFunctionsResponse"
        }
      },
      "additionalProperties": false
    },
    "protoObject": {
      "type": "object",
      "description": "An evolving ProtoJSON message from GoogleSQL. Its members track the pinned GoogleSQL commit, which is the point of reading them from the tool."
    },
    "languageOptionsSuccess": {
      "type": "object",
      "required": [
        "response"
      ],
      "properties": {
        "response": {
          "$ref": "#/$defs/protoObject"
        }
      },
      "additionalProperties": false
    },
    "analyzerOptionsSuccess": {
      "type": "object",
      "required": [
        "response"
      ],
      "properties": {
        "response": {
          "$ref": "#/$defs/protoObject"
        }
      },
      "additionalProperties": false
    },
    "errorLocation": {
      "type": "object",
      "required": [
        "line",
        "column",
        "byteOffset",
        "filename"
      ],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "column": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "byteOffset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "filename": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": [
        "origin",
        "statusCode",
        "statusName",
        "message",
        "inputLine"
      ],
      "properties": {
        "origin": {
          "description": "The layer that rejected the request: the ProtoJSON decoder, this tool's own protocol rules, GoogleSQL itself, or this tool on an internal failure.",
          "enum": [
            "protocol",
            "proto_json",
            "googlesql",
            "internal"
          ]
        },
        "statusCode": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "statusName": {
          "enum": [
            "CANCELLED",
            "UNKNOWN",
            "INVALID_ARGUMENT",
            "DEADLINE_EXCEEDED",
            "NOT_FOUND",
            "ALREADY_EXISTS",
            "PERMISSION_DENIED",
            "RESOURCE_EXHAUSTED",
            "FAILED_PRECONDITION",
            "ABORTED",
            "OUT_OF_RANGE",
            "UNIMPLEMENTED",
            "INTERNAL",
            "UNAVAILABLE",
            "DATA_LOSS",
            "UNAUTHENTICATED"
          ]
        },
        "message": {
          "type": "string"
        },
        "inputLine": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "location": {
          "$ref": "#/$defs/errorLocation"
        },
        "operation": {
          "enum": [
            "analyze",
            "parse",
            "builtinFunctions",
            "languageOptions",
            "analyzerOptions"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
