{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fornwall/googlesql-frontend/schema/request.schema.json",
  "title": "googlesql-frontend NDJSON request",
  "description": "One standard-input request object, encoded on one NDJSON line.",
  "type": "object",
  "required": [
    "protocolVersion"
  ],
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "responseOptions": {
      "$ref": "#/$defs/responseOptions"
    },
    "analyze": {
      "$ref": "#/$defs/analyzeOperation"
    },
    "parse": {
      "$ref": "#/$defs/parseOperation"
    },
    "builtinFunctions": {
      "$ref": "#/$defs/builtinFunctionsOperation"
    },
    "languageOptions": {
      "$ref": "#/$defs/languageOptionsOperation"
    },
    "analyzerOptions": {
      "$ref": "#/$defs/analyzerOptionsOperation"
    }
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "required": [
        "analyze"
      ]
    },
    {
      "required": [
        "parse"
      ]
    },
    {
      "required": [
        "builtinFunctions"
      ]
    },
    {
      "required": [
        "languageOptions"
      ]
    },
    {
      "required": [
        "analyzerOptions"
      ]
    }
  ],
  "$defs": {
    "responseOptions": {
      "type": "object",
      "description": "Selects how much of a successful reply is sent back. It applies to whichever operation the request carries.",
      "properties": {
        "omitResponseProto": {
          "type": "boolean",
          "description": "Drops the serialized AST from an analyze or parse reply, keeping debugString and any resumeBytePosition. The other operations reply with nothing but their response proto and reject it."
        }
      },
      "additionalProperties": false
    },
    "protoObject": {
      "type": "object",
      "description": "An evolving nested ProtoJSON message. The protobuf decoder performs field-level validation."
    },
    "int64": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)$",
      "description": "Canonical ProtoJSON representation of an int64. Range is checked by the protobuf decoder."
    },
    "parseResumeLocation": {
      "type": "object",
      "properties": {
        "filename": {
          "type": "string"
        },
        "input": {
          "type": "string"
        },
        "bytePosition": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "allowResume": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "analyzeRequest": {
      "type": "object",
      "properties": {
        "options": {
          "$ref": "#/$defs/protoObject"
        },
        "simpleCatalog": {
          "$ref": "#/$defs/protoObject"
        },
        "descriptorPoolList": {
          "$ref": "#/$defs/protoObject"
        },
        "registeredCatalogId": {
          "$ref": "#/$defs/int64"
        },
        "sqlStatement": {
          "type": "string"
        },
        "parseResumeLocation": {
          "$ref": "#/$defs/parseResumeLocation"
        },
        "sqlExpression": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "sqlStatement"
          ]
        },
        {
          "required": [
            "parseResumeLocation"
          ]
        },
        {
          "required": [
            "sqlExpression"
          ]
        }
      ]
    },
    "parseRequest": {
      "type": "object",
      "properties": {
        "sqlStatement": {
          "type": "string"
        },
        "parseResumeLocation": {
          "$ref": "#/$defs/parseResumeLocation"
        },
        "options": {
          "$ref": "#/$defs/protoObject"
        },
        "allowScript": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "sqlStatement"
          ]
        },
        {
          "required": [
            "parseResumeLocation"
          ]
        }
      ]
    },
    "extendedParseRequest": {
      "type": "object",
      "required": [
        "sql",
        "root"
      ],
      "properties": {
        "sql": {
          "type": "string"
        },
        "root": {
          "enum": [
            "EXPRESSION",
            "TYPE",
            "PARSE_MULTIPLE"
          ]
        },
        "options": {
          "$ref": "#/$defs/protoObject"
        }
      },
      "additionalProperties": false
    },
    "renderOptions": {
      "type": "object",
      "properties": {
        "outputAscExplicitly": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "languageVersion": {
      "description": "A googlesql.LanguageVersion ProtoJSON enum name, or its accepted numeric representation.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        }
      ]
    },
    "languageOptionsPreset": {
      "type": "object",
      "description": "A named starting point for the language options. On analyze and parse it is merged under the request's own languageOptions; on languageOptions it is the configuration to expand and report.",
      "properties": {
        "features": {
          "enum": [
            "LANGUAGE_FEATURES_DEFAULT",
            "LANGUAGE_FEATURES_MAXIMUM",
            "LANGUAGE_FEATURES_DEVELOPMENT"
          ]
        },
        "languageVersion": {
          "$ref": "#/$defs/languageVersion"
        },
        "allReservableKeywordsReserved": {
          "type": "boolean"
        },
        "allStatementKindsSupported": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "rewriteSet": {
      "description": "The resolved-AST rewrite baseline the analyzer starts from, before request.options.enabledRewrites is added to it. REWRITES_AS_REQUESTED, the default, enables exactly the rewrites that list names. REWRITES_DEFAULT enables the set a default-constructed GoogleSQL AnalyzerOptions carries.",
      "enum": [
        "REWRITES_AS_REQUESTED",
        "REWRITES_DEFAULT"
      ]
    },
    "functionSignatureId": {
      "description": "A ProtoJSON enum name or its accepted numeric representation.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        }
      ]
    },
    "enabledRewrite": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/functionSignatureId"
        },
        "value": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "builtinFunctionsRequest": {
      "type": "object",
      "properties": {
        "languageOptions": {
          "$ref": "#/$defs/protoObject"
        },
        "includeFunctionIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/functionSignatureId"
          }
        },
        "excludeFunctionIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/functionSignatureId"
          }
        },
        "enabledRewritesMapEntry": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/enabledRewrite"
          }
        }
      },
      "additionalProperties": false
    },
    "analyzeOperation": {
      "type": "object",
      "required": [
        "request"
      ],
      "properties": {
        "request": {
          "$ref": "#/$defs/analyzeRequest"
        },
        "namedCatalog": {
          "enum": [
            "CATALOG_NONE",
            "CATALOG_SAMPLE"
          ]
        },
        "languageOptionsPreset": {
          "$ref": "#/$defs/languageOptionsPreset"
        },
        "rewrites": {
          "$ref": "#/$defs/rewriteSet"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "not": {
            "required": [
              "namedCatalog"
            ],
            "properties": {
              "request": {
                "required": [
                  "simpleCatalog"
                ]
              }
            }
          }
        },
        {
          "not": {
            "required": [
              "namedCatalog"
            ],
            "properties": {
              "request": {
                "required": [
                  "registeredCatalogId"
                ]
              }
            }
          }
        }
      ]
    },
    "parseOperation": {
      "type": "object",
      "properties": {
        "request": {
          "$ref": "#/$defs/parseRequest"
        },
        "extendedRequest": {
          "$ref": "#/$defs/extendedParseRequest"
        },
        "renderOptions": {
          "$ref": "#/$defs/renderOptions"
        },
        "languageOptionsPreset": {
          "$ref": "#/$defs/languageOptionsPreset"
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "request"
          ]
        },
        {
          "required": [
            "extendedRequest"
          ]
        }
      ]
    },
    "builtinFunctionsOperation": {
      "type": "object",
      "required": [
        "request"
      ],
      "properties": {
        "request": {
          "$ref": "#/$defs/builtinFunctionsRequest"
        }
      },
      "additionalProperties": false
    },
    "languageOptionsRequest": {
      "type": "object",
      "properties": {
        "maximumFeatures": {
          "type": "boolean"
        },
        "languageVersion": {
          "$ref": "#/$defs/languageVersion"
        }
      },
      "additionalProperties": false
    },
    "analyzerOptionsRequest": {
      "type": "object",
      "description": "googlesql.local_service.AnalyzerOptionsRequest carries no fields.",
      "properties": {},
      "additionalProperties": false
    },
    "languageOptionsOperation": {
      "type": "object",
      "description": "Reports the language options of this build. At most one of request and preset; neither reports GoogleSQL's defaults.",
      "properties": {
        "request": {
          "$ref": "#/$defs/languageOptionsRequest"
        },
        "preset": {
          "$ref": "#/$defs/languageOptionsPreset"
        }
      },
      "additionalProperties": false,
      "not": {
        "required": [
          "request",
          "preset"
        ]
      }
    },
    "analyzerOptionsOperation": {
      "type": "object",
      "properties": {
        "request": {
          "$ref": "#/$defs/analyzerOptionsRequest"
        }
      },
      "additionalProperties": false
    }
  }
}
