load("@com_google_protobuf//bazel:cc_proto_library.bzl", "cc_proto_library")
load("@com_google_protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

proto_library(
    name = "protocol_proto",
    srcs = ["protocol.proto"],
    visibility = ["//visibility:public"],
    deps = [
        "@googlesql//googlesql/local_service:local_service_proto",
        "@googlesql//googlesql/parser:parse_tree_proto",
        "@googlesql//googlesql/proto:options_proto",
        "@googlesql//googlesql/public:options_proto",
    ],
)

cc_proto_library(
    name = "protocol_cc_proto",
    visibility = ["//visibility:public"],
    deps = [":protocol_proto"],
)

cc_library(
    name = "frontend",
    srcs = ["frontend.cc"],
    hdrs = ["frontend.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":protocol_cc_proto",
        "@com_google_absl//absl/cleanup",
        "@com_google_absl//absl/container:flat_hash_set",
        "@com_google_absl//absl/flags:flag",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_protobuf//:json_util",
        "@com_google_protobuf//:protobuf",
        "@googlesql//googlesql/common:proto_helper",
        "@googlesql//googlesql/local_service",
        "@googlesql//googlesql/local_service:local_service_cc_proto",
        "@googlesql//googlesql/parser",
        "@googlesql//googlesql/parser:parse_tree_serializer",
        "@googlesql//googlesql/proto:options_cc_proto",
        "@googlesql//googlesql/public:analyzer",
        "@googlesql//googlesql/public:analyzer_options",
        "@googlesql//googlesql/public:analyzer_output",
        "@googlesql//googlesql/public:builtin_function_options",
        "@googlesql//googlesql/public:catalog",
        "@googlesql//googlesql/public:error_helpers",
        "@googlesql//googlesql/public:error_location_cc_proto",
        "@googlesql//googlesql/public:evaluator",
        "@googlesql//googlesql/public:language_options",
        "@googlesql//googlesql/public:parse_location",
        "@googlesql//googlesql/public:parse_resume_location",
        "@googlesql//googlesql/public:prepared_expression_constant_evaluator",
        "@googlesql//googlesql/public:simple_catalog",
        "@googlesql//googlesql/public:simple_catalog_util",
        "@googlesql//googlesql/public/types:type_factory",
        "@googlesql//googlesql/resolved_ast",
        "@googlesql//googlesql/testdata:sample_catalog_impl",
        "@icu//:icudata_lib",
        "@icu//:icui18n_lib",
        "@icu//:icuuc_lib",
    ],
)

cc_binary(
    name = "googlesql-frontend",
    srcs = ["main.cc"],
    linkstatic = True,
    visibility = ["//visibility:public"],
    deps = [
        ":frontend",
        "@com_google_absl//absl/flags:config",
        "@com_google_absl//absl/flags:parse",
        "@com_google_absl//absl/flags:usage",
        "@com_google_absl//absl/log:initialize",
    ],
)

cc_test(
    name = "frontend_test",
    srcs = ["frontend_test.cc"],
    linkstatic = True,
    deps = [
        ":frontend",
        ":protocol_cc_proto",
        "@com_google_googletest//:gtest_main",
        "@com_google_protobuf//:json_util",
        "@com_google_protobuf//:protobuf",
    ],
)
