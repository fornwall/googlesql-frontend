module(
    name = "googlesql_frontend",
    version = "0.1.0",
)

bazel_dep(name = "googlesql", version = "2026.7.4")
archive_override(
    module_name = "googlesql",
    integrity = "sha256-mOsO2Ou5Ws8AkvlX3iz0zXLgKJBw/dSQx6zNjYSlM1w=",
    patch_strip = 1,
    patches = ["//patches/googlesql:pull-5.patch"],
    strip_prefix = "googlesql-1f8aa333f4d6353cd3a64471fc83121df72df3f7",
    urls = ["https://github.com/google/googlesql/archive/1f8aa333f4d6353cd3a64471fc83121df72df3f7.tar.gz"],
)

bazel_dep(name = "abseil-cpp", version = "20260107.0", repo_name = "com_google_absl")
bazel_dep(name = "googletest", version = "1.17.0", repo_name = "com_google_googletest")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "protobuf", version = "33.5", repo_name = "com_google_protobuf")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_python", version = "1.7.0")

# GoogleSQL's default ICU repository builds ICU through Autotools. Replace it
# with a native Bazel build so the same dependency graph works on Linux and
# macOS. The release archive's prebuilt data package is embedded in the binary,
# leaving no runtime ICU data files to locate.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "icu",
    build_file = "//third_party/icu:icu.BUILD",
    patch_cmds = ["find source -name BUILD.bazel -delete"],
    sha256 = "dfacb46bfe4747410472ce3e1144bf28a102feeaa4e3875bac9b4c6cf30f4f3e",
    strip_prefix = "icu",
    urls = ["https://github.com/unicode-org/icu/releases/download/release-76-1/icu4c-76_1-src.tgz"],
)

googlesql_http_archive_deps = use_extension(
    "@googlesql//bazel:http_archive_deps.bzl",
    "googlesql_http_archive_deps",
)

override_repo(
    googlesql_http_archive_deps,
    icu = "icu",
)
